@using System.Net
@inject WebhooksClient WebhooksClient

@if (message is not null)
{
    <div class="error-message" role="alert">@message</div>
}

@if (webhooks is null)
{
    <div class="grid-placeholder">Loading...</div>
}
else if (webhooks.Any())
{
    <QuickGrid Items="@webhooks">
        <PropertyColumn Sortable="@true" IsDefaultSortColumn="true" InitialSortDirection="@SortDirection.Descending" Title="Date" Property="@(hook => hook.Date)" />
        <PropertyColumn Sortable="@true" Title="Destination" Property="@(hook => hook.DestUrl)" />
        <PropertyColumn Sortable="@true" Title="Token" Property="@(hook => hook.Token)" />
        <TemplateColumn>
            <button class="action" type="button" @onclick="@(() => RemoveAsync(context))">Remove</button>
        </TemplateColumn>
    </QuickGrid>
}
else
{
    <div class="grid-placeholder">None registered</div>
}

@code {
    IQueryable<WebhookResponse>? webhooks;
    string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        webhooks = (await WebhooksClient.LoadWebhooks()).AsQueryable();
    }

    private async Task RemoveAsync(WebhookResponse hook)
    {
        message = null;
        using var response = await WebhooksClient.DeleteWebhookAsync(hook.Id);

        if (response.IsSuccessStatusCode)
        {
            webhooks = webhooks?.Where(h => h.Id != hook.Id).ToList().AsQueryable();
        }
        else if (response.StatusCode == HttpStatusCode.NotFound)
        {
            message = "This webhook no longer exists.";
            await LoadAsync();
        }
        else
        {
            message = "The webhook could not be removed. Please try again.";
        }
    }
}
