<div class="login-page">
    <partial name="_LoginVisual" />

    <section class="login-card" aria-labelledby="change-password-title">
        <div class="login-card-header">
            <h1 id="change-password-title">Change password</h1>
        </div>

        <div class="login-form">
            <p class="login-hint" role="status">Your password has been changed.</p>
            <a class="btn btn-primary login-submit" href="@ViewData["ShopUrl"]">Back to the shop</a>
        </div>
    </section>
</div>
