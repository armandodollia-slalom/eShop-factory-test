@page "/user/orders"
@attribute [Authorize]
@attribute [StreamRendering]
@inject OrderingService OrderingService

<PageTitle>My orders | AdventureWorks</PageTitle>
<SectionContent SectionName="page-header-title">My orders</SectionContent>
<OrdersRefreshOnStatusChange />

<div class="orders">
@if (orders is null)
{
    <p class="orders-loading" role="status">Loading your orders...</p>
}
else if (!hasAnyOrders)
{
    <div class="orders-empty">
        <span class="orders-empty-icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 16h24l-2 22H14z" />
                <path d="M18 16v-2a6 6 0 0 1 12 0v2" />
            </svg>
        </span>
        <h2>No orders yet</h2>
        <p>When you place an order, it shows up here with its status and total.</p>
        <a class="button button-primary" href="/">Start shopping</a>
    </div>
}
else
{
    <nav class="orders-filter" aria-labelledby="orders-filter-label">
        <span class="orders-filter-label" id="orders-filter-label">Status</span>
        <ul class="orders-filter-options">
            <li>
                <a class="orders-filter-option" href="user/orders" aria-current="@(selectedStatus is null ? "true" : null)">All</a>
            </li>
            @foreach (var status in Statuses)
            {
                <li>
                    <a class="orders-filter-option" href="user/orders?status=@status" aria-current="@(status == selectedStatus ? "true" : null)">@status</a>
                </li>
            }
        </ul>
    </nav>

    @if (orders.Length == 0)
    {
        <div class="orders-filter-empty" role="status">
            <p>No @selectedStatus orders.</p>
            <a href="user/orders">Show all orders</a>
        </div>
    }
    else
    {
        <ul class="orders-list">
            <li class="orders-header orders-item">
                <div>Number</div>
                <div>Date</div>
                <div class="total-header">Total</div>
                <div>Status</div>
            </li>
            @foreach (var order in orders)
            {
                <li class="orders-item">
                    <div class="order-number">
                        @order.OrderNumber
                    </div>
                    <div class="order-date">
                        @order.Date
                    </div>
                    <div class="order-total">
                       $@order.Total.ToPriceDisplay()
                    </div>
                    <div class="order-status">
                        <span class="status @order.Status.ToLower()">
                            @order.Status
                        </span>
                    </div>
                </li>
            }
        </ul>
    }
}
</div>

@code {
    // The status names Ordering.API reports and accepts in ?status=, in its order.
    private static readonly string[] Statuses = ["Submitted", "AwaitingValidation", "StockConfirmed", "Paid", "Shipped", "Cancelled"];

    private OrderRecord[]? orders;
    private bool hasAnyOrders;
    private string? selectedStatus;

    [SupplyParameterFromQuery(Name = "status")]
    public string? Status { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // An unknown status falls back to "All" instead of reaching the API, which would answer 400.
        selectedStatus = Statuses.FirstOrDefault(s => string.Equals(s, Status, StringComparison.OrdinalIgnoreCase));

        var result = await OrderingService.GetOrders(selectedStatus);

        // A filter with no matches must not look like a shopper with no orders at all.
        hasAnyOrders = result.Length > 0
            || (selectedStatus is not null && (await OrderingService.GetOrders()).Length > 0);
        orders = result;
    }
}
