            "sha256": "6efed18c4539a663fd3c851a2be9533fd8456c4e646d9416206da059154a0d3c",
            "bin": "zizmor"
          },
          "win32-x64": {
            "url": "https://github.com/zizmorcore/zizmor/releases/download/v1.32.0/zizmor-x86_64-pc-windows-msvc.zip",
            "sha256": "d284a16e09d9df4ce2c000357e7b59bd531be093bea5718a1ce225b449b59d49",
            "bin": "zizmor.exe"
          }
        }
      },
      "rules": [],
      "rulesArg": "--config",
      "validateRule": null,
      "prepare": null,
      "when": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "okExit": null,
      "data": [],
      "errorPattern": null,
      "missingPattern": null,
      "ruleFilter": null,
      "needsRules": false
    },
    "actionlint": {
      "run": [
        "{bin}",
        "-no-color",
        "-shellcheck=",
        "-pyflakes=",
        "-format",
        "{{json .}}"
      ],
      "parse": "actionlint-json",
      "output": "stdout",
      "baseline": "merge-base",
      "block": {
        "levels": [
          "error"
        ],
        "rules": []
      },
      "timeoutSec": 600,
      "env": {},
      "install": {
        "name": "actionlint",
        "version": "1.7.12",
        "platforms": {
          "linux-x64": {
            "url": "https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_amd64.tar.gz",
            "sha256": "8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8",
