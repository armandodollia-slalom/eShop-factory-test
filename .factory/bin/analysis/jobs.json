            "sha256": "aba9ced2dee8d27fecca3dc7feb1a7f9a52caefa1eb46f3271ea66b6e0e6953f",
            "bin": "actionlint"
          },
          "win32-x64": {
            "url": "https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_windows_amd64.zip",
            "sha256": "6e7241b51e6817ea6a047693d8e6fed13b31819c9a0dd6c5a726e1592d22f6e9",
            "bin": "actionlint.exe"
          },
          "win32-arm64": {
            "url": "https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_windows_arm64.zip",
            "sha256": "cadcf7ea4efe3a68728893813643cebe1185e5b1d4be5b96245f65c9a4d5ea41",
            "bin": "actionlint.exe"
          }
        }
      },
      "rules": [],
      "rulesArg": "--config",
      "validateRule": null,
      "prepare": null,
      "when": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml"
      ],
      "okExit": [
        0,
        1
      ],
      "data": [],
      "errorPattern": null,
      "missingPattern": null,
      "ruleFilter": null,
      "needsRules": false
    }
  },
  "vars": {
    "solution": "eShop.Web.slnf"
  }
}
