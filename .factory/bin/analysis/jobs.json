{
  "$comment": "Generated by `factory render`. Do not edit.",
  "jobs": [
    {
      "id": "secrets",
      "name": "Secret scan",
      "tools": [
        "betterleaks"
      ],
      "required": true,
      "when": [
        "pull_request"
      ],
      "fetchDepth": 0,
      "toolchain": false,
      "timeoutMin": 30,
      "description": null
    },
    {
      "id": "dependencies",
      "name": "Dependency audit",
      "tools": [
        "osv-scanner",
        "nuget-audit"
      ],
      "required": true,
      "when": [
        "pull_request"
      ],
      "fetchDepth": 0,
      "toolchain": true,
      "timeoutMin": 30,
      "description": null
    },
    {
      "id": "sast",
      "name": "Security patterns (SAST)",
      "tools": [
        "opengrep-interfile"
      ],
      "required": true,
      "when": [
        "pull_request"
      ],
      "fetchDepth": 0,
      "toolchain": false,
      "timeoutMin": 45,
      "description": null
    },
    {
      "id": "workflows",
      "name": "Workflow lint",
      "tools": [
        "zizmor",
        "actionlint"
      ],
      "required": true,
      "when": [
        "pull_request"
      ],
      "fetchDepth": 0,
      "toolchain": false,
      "timeoutMin": 30,
      "description": null
    }
  ],
  "tools": {
    "betterleaks": {
      "run": [
        "{bin}",
        "git",
        "--no-banner",
        "--redact",
        "--log-opts={range}",
        "-f",
        "sarif",
        "-r",
        "{out}",
        "."
      ],
      "parse": "sarif",
      "output": "{out}",
      "baseline": "native",
      "block": {
        "levels": [],
        "rules": [
          "*"
        ]
      },
      "timeoutSec": 600,
      "env": {
        "BETTERLEAKS_CONFIG_TOML": "[extend]\nuseDefault = true\n\n[[allowlists]]\ndescription = \"analysis.secrets.allow in .factory/config.json\"\nstopwords = [\"Pass123$\"]\n"
      },
      "install": {
        "name": "betterleaks",
        "version": "1.10.1",
        "platforms": {
          "linux-x64": {
            "url": "https://github.com/betterleaks/betterleaks/releases/download/v1.10.1/betterleaks_1.10.1_linux_x64.tar.gz",
            "sha256": "c174b42d7aa60caf58c0c3e555c0e4bed01fe6b0d99a412bce777b5af4ce913e",
            "bin": "betterleaks"
          },
          "linux-arm64": {
            "url": "https://github.com/betterleaks/betterleaks/releases/download/v1.10.1/betterleaks_1.10.1_linux_arm64.tar.gz",
            "sha256": "62a63199f9f61a6b5e5a6f58f048493db20fbc8c770014f4d903a4d97886e1bf",
            "bin": "betterleaks"
          },
          "darwin-x64": {
            "url": "https://github.com/betterleaks/betterleaks/releases/download/v1.10.1/betterleaks_1.10.1_darwin_x64.tar.gz",
            "sha256": "1ae2e3885d161918d8ad2e911e205e73f0d9ffba52c85b38126586c52d355ef4",
            "bin": "betterleaks"
          },
          "darwin-arm64": {
            "url": "https://github.com/betterleaks/betterleaks/releases/download/v1.10.1/betterleaks_1.10.1_darwin_arm64.tar.gz",
            "sha256": "ca91eb3b006f15478411f235b5e2712fb15cea74f6701ebadc2364efe0af1403",
            "bin": "betterleaks"
          },
          "win32-x64": {
            "url": "https://github.com/betterleaks/betterleaks/releases/download/v1.10.1/betterleaks_1.10.1_windows_x64.zip",
            "sha256": "53d4b37635a999992fb8e1d79f8215279315cbb3b4139314289b69407e79143d",
            "bin": "betterleaks.exe"
          },
          "win32-arm64": {
            "url": "https://github.com/betterleaks/betterleaks/releases/download/v1.10.1/betterleaks_1.10.1_windows_arm64.zip",
            "sha256": "f93d26dfc7b939f967c74e3f908b44faec1b1cb6ffb29c75c0a1d7e713ab8f70",
            "bin": "betterleaks.exe"
          }
        }
      },
      "rules": [],
      "rulesArg": "--config",
      "validateRule": null,
      "prepare": null,
      "when": null,
      "okExit": [
        0,
        1
      ],
      "data": [],
      "errorPattern": null,
      "missingPattern": null,
      "ruleFilter": null,
      "needsRules": false
    },
    "osv-scanner": {
      "run": [
        "{bin}",
        "scan",
        "source",
        "--offline",
        "--data-source",
        "native",
        "--allow-no-lockfiles",
        "--format",
        "json",
        "--output-file",
        "{out}",
        "-r",
        "."
      ],
      "parse": "osv-json",
      "output": "{out}",
      "baseline": "merge-base",
      "block": {
        "levels": [
          "error"
        ],
        "rules": []
      },
      "timeoutSec": 600,
      "env": {
        "OSV_SCANNER_LOCAL_DB_CACHE_DIRECTORY": "{cache}/db"
      },
      "install": {
        "name": "osv-scanner",
        "version": "2.7.1",
        "platforms": {
          "linux-x64": {
            "url": "https://github.com/google/osv-scanner/releases/download/v2.7.1/osv-scanner_linux_amd64",
            "sha256": "fb7dab19a8bd9bbe5c3189f09d4b7ee1820c9553a23bac202648a56efd2f6ee8",
            "bin": "osv-scanner"
          },
          "linux-arm64": {
            "url": "https://github.com/google/osv-scanner/releases/download/v2.7.1/osv-scanner_linux_arm64",
            "sha256": "983d22fbad9724514e3fcc6acc83b5fa64c5ffa6b0d9f510028f22c1b223ff81",
            "bin": "osv-scanner"
          },
          "darwin-x64": {
            "url": "https://github.com/google/osv-scanner/releases/download/v2.7.1/osv-scanner_darwin_amd64",
            "sha256": "b8420d5485ba792626315f1bf9a5a2046e971d38eea75bf9090c38852dbc3b1b",
            "bin": "osv-scanner"
          },
          "darwin-arm64": {
            "url": "https://github.com/google/osv-scanner/releases/download/v2.7.1/osv-scanner_darwin_arm64",
            "sha256": "b22c02877a811c8f78956e8643efa554932b7378f590d13f8e97d4e9448a29f3",
            "bin": "osv-scanner"
          },
          "win32-x64": {
            "url": "https://github.com/google/osv-scanner/releases/download/v2.7.1/osv-scanner_windows_amd64.exe",
            "sha256": "7121dcf420aefbbf89a7f0050c4d3094e079ff93afd334dfc96f16b02ec85800",
            "bin": "osv-scanner.exe"
          },
          "win32-arm64": {
            "url": "https://github.com/google/osv-scanner/releases/download/v2.7.1/osv-scanner_windows_arm64.exe",
            "sha256": "5f3998b55c9268f8468502bbcb60645038fd5b145ee5e685e6ae2a32e923afc7",
            "bin": "osv-scanner.exe"
          }
        }
      },
      "rules": [],
      "rulesArg": "--config",
      "validateRule": null,
      "prepare": [
        "{bin}",
        "scan",
        "source",
        "--offline-vulnerabilities",
        "--download-offline-databases",
        "--data-source",
        "native",
        "--allow-no-lockfiles",
        "--format",
        "json",
        "--output-file",
        "{cache}/prepare.json",
        "-r",
        "{root}"
      ],
      "when": null,
      "okExit": [
        0,
        1
      ],
      "data": [
        {
          "id": "osv-language-ecosystems",
          "licence": "CC-BY-4.0",
          "note": "Advisories for language package ecosystems (GitHub Advisory Database, PyPA, Go, RustSec, ...): CC-BY-4.0 or more permissive. Only the ecosystems the repository's lockfiles use are downloaded."
        },
        {
          "id": "osv-os-distributions",
          "paths": [
            "Debian",
            "Ubuntu",
            "Alpine",
            "Red Hat",
            "SUSE",
            "openSUSE",
            "Rocky Linux",
            "AlmaLinux",
            "GIT"
          ],
          "licence": "unstated or share-alike (per distribution); NVD-converted",
          "licenceReview": "pending",
          "note": "Enabled by the owner's decision while a lawyer reviews the data licences; fetched only when the repository's ecosystems need them."
        },
        {
          "id": "osv-wolfi-chainguard",
          "paths": [
            "Wolfi",
            "Chainguard"
          ],
          "licence": "CC-BY-NC-ND-4.0",
          "excluded": true,
          "note": "Never fetched or kept: an explicit non-commercial term. Removed after every database download."
        }
      ],
      "errorPattern": "could not load db|unable to fetch OSV database",
      "missingPattern": null,
      "ruleFilter": null,
      "needsRules": false
    },
    "nuget-audit": {
      "run": "dotnet restore {solution} -v q && dotnet list {solution} package --vulnerable --include-transitive --format json",
      "parse": "module:./parsers/nuget-audit.mjs",
      "output": "stdout",
      "baseline": "merge-base",
      "block": {
        "levels": [
          "error"
        ],
        "rules": []
      },
      "timeoutSec": 900,
      "env": {},
      "install": null,
      "rules": [],
      "rulesArg": "--config",
      "validateRule": null,
      "prepare": null,
      "when": [
        "**/*.csproj"
      ],
      "okExit": null,
      "data": [
        {
          "id": "github-advisory-database",
          "licence": "CC-BY-4.0",
          "note": "nuget.org's vulnerability data is the GitHub Advisory Database."
        }
      ],
      "errorPattern": null,
      "missingPattern": null,
      "ruleFilter": null,
      "needsRules": false
    },
    "opengrep-interfile": {
      "run": [
        "{bin}",
        "scan",
        "--quiet",
        "--enable-interfile",
        "{rules}",
        "--baseline-commit",
        "{mergeBase}",
        "--sarif-output={out}",
        "."
      ],
      "parse": "sarif",
      "output": "{out}",
      "baseline": "native",
      "block": {
        "levels": [
          "error"
        ],
        "rules": []
      },
      "timeoutSec": 1800,
      "env": {},
      "install": {
        "name": "opengrep",
        "version": "2.0.0",
        "platforms": {
          "linux-x64": {
            "url": "https://github.com/opengrep/opengrep/releases/download/v2.0.0/opengrep_linux_x86",
            "sha256": "37e93f4da5fd04a18c5c1febbdd12f7e98dfccd4d0c9cf2593bcb25eeb462da0",
            "bin": "opengrep"
          },
          "linux-arm64": {
            "url": "https://github.com/opengrep/opengrep/releases/download/v2.0.0/opengrep_linux_aarch64",
            "sha256": "6257b65423a744b704af2ff9beeb8f222c2f6925236af386b56b031d4c06d6d8",
            "bin": "opengrep"
          },
          "darwin-x64": {
            "url": "https://github.com/opengrep/opengrep/releases/download/v2.0.0/opengrep_osx_x86",
            "sha256": "51d2f918d7aad0afc1426bb4fbf56e32fc70c3ffd5ddb78e32e7d61e51c029a2",
            "bin": "opengrep"
          },
          "darwin-arm64": {
            "url": "https://github.com/opengrep/opengrep/releases/download/v2.0.0/opengrep_osx_arm64",
            "sha256": "b51b3d83f165a2e0934497b8f1b08abb1c3041ef20ef911c97e04cb39af1ad55",
            "bin": "opengrep"
          },
          "win32-x64": {
            "url": "https://github.com/opengrep/opengrep/releases/download/v2.0.0/opengrep_windows_x86.zip",
            "sha256": "899a17e2b15863367cfd15032c93cdf482fd4e7ec8719c69de46f4f38b227864",
            "bin": "opengrep.exe"
          }
        }
      },
      "rules": [
        {
          "id": "gitlab-sast-rules",
          "repo": "https://gitlab.com/gitlab-org/security-products/sast-rules.git",
          "commit": "83144bd2ec7d3200cda96347fa923f81c8ad8413",
          "dir": null,
          "builtin": null,
          "include": [
            "java",
            "scala",
            "python",
            "csharp",
            "javascript"
          ],
          "exclude": [],
          "licence": "MIT",
          "licenceReview": null,
          "requireHeader": "License: MIT (c) GitLab Inc.",
          "note": "Only files carrying the MIT header are loaded. rules/lgpl-cc (Commons Clause) and rules/gitlab (GitLab EE licence) are never included."
        },
        {
          "id": "gitlab-sast-rules-go-c",
          "repo": "https://gitlab.com/gitlab-org/security-products/sast-rules.git",
          "commit": "83144bd2ec7d3200cda96347fa923f81c8ad8413",
          "dir": null,
          "builtin": null,
          "include": [
            "go",
            "c"
          ],
          "exclude": [],
          "licence": "MIT",
          "licenceReview": "pending",
          "requireHeader": null,
          "note": "Enabled by the owner's decision while a lawyer reviews provenance: these files carry no MIT header, and the repository LICENSE says third-party components keep their original licence."
        },
        {
          "id": "factory",
          "repo": null,
          "commit": null,
          "dir": null,
          "builtin": null,
          "include": [
            "typescript",
            "csharp"
          ],
          "exclude": [],
          "licence": "MIT",
          "licenceReview": null,
          "requireHeader": null,
          "note": "The factory's own rules (packs/security/rules/opengrep).",
          "dirs": [
            ".factory/bin/analysis/rules/opengrep/typescript",
            ".factory/bin/analysis/rules/opengrep/csharp"
          ]
        }
      ],
      "rulesArg": "--config",
      "validateRule": [
        "{bin}",
        "scan",
        "--config",
        "{rule}",
        "{empty}"
      ],
      "prepare": null,
      "when": null,
      "okExit": [
        0,
        1
      ],
      "data": [],
      "errorPattern": null,
      "missingPattern": null,
      "ruleFilter": null,
      "needsRules": true
    },
    "zizmor": {
      "run": [
        "{bin}",
        "--offline",
        "--format",
        "sarif",
        "."
      ],
      "parse": "sarif",
      "output": "stdout",
      "baseline": "merge-base",
      "block": {
        "levels": [
          "error"
        ],
        "rules": []
      },
      "timeoutSec": 600,
      "env": {},
      "install": {
        "name": "zizmor",
        "version": "1.32.0",
        "platforms": {
          "linux-x64": {
