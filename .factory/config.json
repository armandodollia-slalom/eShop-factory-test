{
  "tickets": {
    "repo": "armandodollia-slalom/eShop-factory-test"
  },
  "board": {
    "owner": "armandodollia-slalom",
    "repo": "armandodollia-slalom/eShop-factory-test",
    "ownerType": "user",
    "projectNumber": 1
  },
  "$comment": "This repository's factory settings. Everything here overrides the engine defaults (docs/configuration.md in the factory). Corrected by the onboard-codebase skill against eShop.Web.slnf and .github/workflows/pr-validation.yml. src/ClientApp and src/HybridApp (.NET MAUI) are not services: CI builds them in a separate MAUI workflow this machine cannot run.",
  "project": {
    "name": "eshop-factory-test",
    "languages": [
      "dotnet",
      "typescript"
    ],
    "toolPaths": [
      "~/.dotnet",
      "~/.dotnet/tools"
    ]
  },
  "lsp": {
    "servers": [
      {
        "id": "csharp",
        "extensions": [
          ".cs"
        ],
        "languageIds": [
          "csharp"
        ],
        "command": "node",
        "args": [
          "pack:dotnet/lsp/roslyn-proxy.mjs",
          "dotnet",
          "tool",
          "run",
          "roslyn-language-server",
          "--stdio",
          "--telemetryLevel",
          "off",
          "--logLevel",
          "Warning"
        ],
        "env": {
          "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
          "DOTNET_NOLOGO": "1"
        },
        "leased": true,
        "reportsState": true,
        "loadTimeoutSec": 900,
        "prepare": {
          "command": "node",
          "args": [
            "pack:dotnet/lsp/prepare.mjs"
          ],
          "label": "restoring tools and NuGet packages",
          "timeoutSec": 900
        },
        "scope": {
          "module": "pack:dotnet/lsp/scope.mjs",
          "options": {
            "solution": "eShop.slnx",
            "restoreSolution": "eShop.Web.slnf"
          }
        }
      },
      {
        "id": "typescript",
        "extensions": [
          ".ts",
          ".tsx",
          ".mts",
          ".cts",
          ".js",
          ".jsx",
          ".mjs",
          ".cjs"
        ],
        "languageIds": [
          "typescript",
          "typescriptreact",
          "javascript",
          "javascriptreact"
        ],
        "command": "typescript-language-server",
        "args": [
          "--stdio"
        ]
      }
    ],
    "check": [
      [
        "csharp",
        "src/Catalog.API/Program.cs",
        26,
        5
      ],
      [
        "typescript",
        "e2e/CartTest.spec.ts",
        6,
        9
      ]
    ]
  },
  "implement": {
    "prepareCmd": "dotnet tool restore && dotnet restore eShop.Web.slnf -v q && npm ci",
    "checks": [
      {
        "name": "build",
        "cmd": "dotnet build eShop.Web.slnf -nologo -v q -clp:ErrorsOnly"
      },
      {
        "name": "test stack matches the application (factory teststack drift)",
        "cmd": "node .factory/bin/factory.mjs teststack drift"
      }
    ],
    "unitTests": {
      "cmd": "dotnet test --project {project}"
    },
    "reviewGate": {
      "floor": {
        "paths": [
          ".github/workflows/**",
          ".github/CODEOWNERS",
          ".factory/config.json",
          "**/Migrations/**",
          "src/Identity.API/**",
          "src/PaymentProcessor/**"
        ]
      },
      "sharedPaths": {
        "Build": [
          "Directory.Build.props",
          "Directory.Build.targets",
          "Directory.Packages.props",
          "global.json",
          "nuget.config"
        ]
      },
      "contractPaths": {
        "Integration events": [
          "src/Basket.API/IntegrationEvents/Events/**",
          "src/Catalog.API/IntegrationEvents/Events/**",
          "src/OrderProcessor/Events/**",
          "src/Ordering.API/Application/IntegrationEvents/Events/**",
          "src/PaymentProcessor/IntegrationEvents/Events/**",
          "src/WebApp/Services/OrderStatus/IntegrationEvents/Events/**",
          "src/Webhooks.API/IntegrationEvents/**"
        ]
      }
    },
    "ui": {
      "teststackCmd": [
        "node",
        ".factory/bin/factory.mjs",
        "teststack"
      ]
    }
  },
  "precheck": {
    "lint": {
      ".cs": [
        "dotnet",
        "format",
        "eShop.Web.slnf",
        "--verify-no-changes",
        "--include",
        "{files}"
      ],
      ".md": [
        "node_modules/.bin/markdownlint",
        "{files}"
      ],
      ".ts": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "{files}"
      ],
      ".tsx": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "{files}"
      ],
      ".js": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "{files}"
      ],
      ".mjs": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "{files}"
      ],
      ".cjs": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "{files}"
      ],
      ".jsx": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "{files}"
      ]
    },
    "fix": {
      ".cs": [
        "dotnet",
        "format",
        "eShop.Web.slnf",
        "--include",
        "{files}"
      ],
      ".md": [
        "node_modules/.bin/markdownlint",
        "--fix",
        "{files}"
      ],
      ".ts": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "--fix",
        "{files}"
      ],
      ".tsx": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "--fix",
        "{files}"
      ],
      ".js": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "--fix",
        "{files}"
      ],
      ".mjs": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "--fix",
        "{files}"
      ],
      ".cjs": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "--fix",
        "{files}"
      ],
      ".jsx": [
        "node",
        "{packs}/typescript/lint/eslint.mjs",
        "--fix",
        "{files}"
      ]
    },
    "testRunners": [
      "dotnet",
      {
        "use": "playwright/playwright",
        "run": [
          "npx",
          "playwright",
          "test",
          "-c",
          "playwright.teststack.config.ts",
          "--grep",
          "{casePrefix}",
          "{files}"
        ],
        "roots": [
          "e2e/teststack"
        ],
        "match": [
          "e2e/teststack/**/*.spec.ts"
        ]
      }
    ]
  },
  "implExclude": [
    ".factory",
    "graphify-out",
    "tests/Application.UnitTests",
    "tests/Basket.FunctionalTests",
    "tests/Basket.UnitTests",
    "tests/Catalog.FunctionalTests",
    "tests/Ordering.FunctionalTests",
    "tests/Ordering.UnitTests",
    "tests/Webhooks.FunctionalTests",
    "tests/eShop.AppHost.UnitTests",
    "e2e",
    "tests/ClientApp.UnitTests"
  ],
  "stack": {
    "resolver": "pack:dotnet/stack/services.mjs",
    "composeFile": ".factory/stack/docker-compose.yaml",
    "build": {
      "all": "node {packs}/dotnet/stack/publish-container.mjs --all",
      "service": "node {packs}/dotnet/stack/publish-container.mjs {service}",
      "inputs": [
        "src/",
        "Directory.Build.props",
        "Directory.Build.targets",
        "Directory.Packages.props",
        "global.json",
        "nuget.config"
      ]
    },
    "publish": "node {packs}/dotnet/stack/aspire-publish.mjs --out {out}"
  },
  "teststack": {
    "commands": {
      "hash-password": "pack:dotnet/stack/hash-password.mjs",
      "drift": "pack:dotnet/stack/apphost-drift.mjs"
    }
  },
  "prVideo": {
    "specPatterns": [
      "e2e/teststack/**/*.spec.ts"
    ],
    "neutralPaths": [
      "src/eShop.ServiceDefaults/**",
      "src/eShop.AppHost/**",
      "src/Shared/**"
    ],
    "api": {
      "extractor": "aspnet-minimal-api",
      "sources": [
        "src/*/Apis/**/*.cs"
      ],
      "openapi": [
        "src/Catalog.API/Catalog.API.json"
      ]
    }
  },
  "agent": {
    "cli": "claude",
    "allowedModels": [
      "opus",
      "sonnet"
    ]
  },
  "metrics": {
    "sink": {
      "type": "directory",
      "path": "/Users/armando.dollia/code/factory-dogfood/metrics-store"
    }
  },
  "retro": {
    "factory": {
      "enabled": true,
      "source": "/Users/armando.dollia/code/ai-app-factory",
      "evidence": "summary"
    }
  }
}
