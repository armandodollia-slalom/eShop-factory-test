        }
      },
      "webapp": {
        "project": "src/WebApp/WebApp.csproj",
        "image": {
          "env": "WEBAPP_IMAGE",
          "name": "eshop-factory-test/webapp"
        }
      }
    },
    "build": {
      "all": "node {packs}/dotnet/stack/publish-container.mjs --all",
      "service": "node {packs}/dotnet/stack/publish-container.mjs {service}",
      "inputs": [
        "src/",
        "Directory.Build.props",
        "Directory.Build.targets",
        "Directory.Packages.props",
        "global.json",
        "nuget.config"
      ]
    }
  },
  "teststack": {
    "stores": {
      "postgres": {
        "type": "postgres",
        "service": "postgres",
        "passwordEnv": "POSTGRES_PASSWORD",
        "databases": [
          "identitydb",
          "catalogdb",
          "orderingdb",
          "webhooksdb"
        ],
        "preserveTables": [
          "__EFMigrationsHistory"
        ],
        "migrationsReady": {
          "table": "__EFMigrationsHistory",
          "column": "MigrationId"
        }
      },
      "redis": {
