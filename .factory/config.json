        }
      },
      "basket-api": {
        "project": "src/Basket.API/Basket.API.csproj",
        "image": {
          "env": "BASKET_API_IMAGE",
          "name": "eshop-factory-test/basket-api"
        }
      },
      "catalog-api": {
        "project": "src/Catalog.API/Catalog.API.csproj",
        "image": {
          "env": "CATALOG_API_IMAGE",
          "name": "eshop-factory-test/catalog-api"
        }
      },
      "ordering-api": {
        "project": "src/Ordering.API/Ordering.API.csproj",
        "image": {
          "env": "ORDERING_API_IMAGE",
          "name": "eshop-factory-test/ordering-api"
        }
      },
      "order-processor": {
        "project": "src/OrderProcessor/OrderProcessor.csproj",
        "image": {
          "env": "ORDER_PROCESSOR_IMAGE",
          "name": "eshop-factory-test/order-processor"
        }
      },
      "payment-processor": {
        "project": "src/PaymentProcessor/PaymentProcessor.csproj",
        "image": {
          "env": "PAYMENT_PROCESSOR_IMAGE",
