    "ownerType": "user",
    "projectNumber": 1
  },
  "$comment": "This repository's factory settings. Everything here overrides the engine defaults (docs/configuration.md in the factory). Corrected by the onboard-codebase skill against eShop.Web.slnf and .github/workflows/pr-validation.yml. src/ClientApp and src/HybridApp (.NET MAUI) are not services: CI builds them in a separate MAUI workflow this machine cannot run.",
  "project": {
    "name": "eshop-factory-test",
    "languages": [
      "dotnet",
      "typescript"
    ],
    "toolPaths": [
      "~/.dotnet",
      "~/.dotnet/tools"
    ],
    "services": [
      {
        "name": "basket-api",
        "kind": "backend",
        "paths": [
          "src/Basket.API/**"
        ],
        "dependsOn": [
          "eshop-servicedefaults",
          "eventbusrabbitmq"
        ],
        "unitTests": "tests/Basket.UnitTests"
      },
      {
        "name": "catalog-api",
        "kind": "backend",
        "paths": [
          "src/Catalog.API/**"
        ],
        "dependsOn": [
          "eventbusrabbitmq",
          "integrationeventlogef",
          "eshop-servicedefaults"
        ],
        "unitTests": "tests/Application.UnitTests"
      },
      {
        "name": "clientapp",
        "kind": "frontend",
        "paths": [
          "src/ClientApp/**"
        ],
        "note": ".NET MAUI: not in eShop.Web.slnf; built by the upstream MAUI workflow only"
      },
      {
        "name": "eventbus",
        "kind": "library",
        "paths": [
          "src/EventBus/**"
        ]
      },
      {
        "name": "eventbusrabbitmq",
        "kind": "library",
        "paths": [
          "src/EventBusRabbitMQ/**"
        ],
        "dependsOn": [
          "eventbus"
        ]
      },
      {
        "name": "hybridapp",
        "kind": "frontend",
        "paths": [
          "src/HybridApp/**"
        ],
        "dependsOn": [
          "webappcomponents"
        ],
        "note": ".NET MAUI: not in eShop.Web.slnf; built by the upstream MAUI workflow only"
      },
      {
        "name": "identity-api",
        "kind": "frontend",
        "paths": [
          "src/Identity.API/**"
        ],
        "dependsOn": [
          "eshop-servicedefaults"
        ],
        "unitTests": "tests/Application.UnitTests"
      },
      {
        "name": "integrationeventlogef",
        "kind": "library",
        "paths": [
          "src/IntegrationEventLogEF/**"
        ],
        "dependsOn": [
          "eventbus"
        ]
      },
      {
        "name": "orderprocessor",
        "kind": "worker",
        "paths": [
          "src/OrderProcessor/**"
        ],
        "dependsOn": [
          "eshop-servicedefaults",
          "eventbusrabbitmq"
        ],
        "unitTests": "tests/Application.UnitTests"
      },
      {
        "name": "ordering-api",
        "kind": "backend",
        "paths": [
          "src/Ordering.API/**"
        ],
        "dependsOn": [
          "eventbusrabbitmq",
          "integrationeventlogef",
          "eshop-servicedefaults",
          "ordering-domain",
          "ordering-infrastructure"
        ],
        "unitTests": "tests/Ordering.UnitTests"
      },
      {
        "name": "ordering-domain",
        "kind": "library",
        "paths": [
          "src/Ordering.Domain/**"
        ],
        "unitTests": "tests/Ordering.UnitTests"
      },
      {
        "name": "ordering-infrastructure",
        "kind": "library",
        "paths": [
          "src/Ordering.Infrastructure/**"
        ],
        "dependsOn": [
          "integrationeventlogef",
          "ordering-domain"
        ],
        "unitTests": "tests/Ordering.UnitTests"
      },
      {
        "name": "paymentprocessor",
        "kind": "worker",
        "paths": [
          "src/PaymentProcessor/**"
        ],
        "dependsOn": [
          "eshop-servicedefaults",
          "eventbusrabbitmq"
        ],
        "unitTests": "tests/Application.UnitTests"
      },
      {
        "name": "webapp",
        "kind": "frontend",
        "paths": [
          "src/WebApp/**"
        ],
        "dependsOn": [
          "eshop-servicedefaults",
          "eventbusrabbitmq",
          "webappcomponents"
        ]
      },
      {
        "name": "webappcomponents",
        "kind": "library",
        "paths": [
          "src/WebAppComponents/**"
        ],
        "ui": true
      },
      {
        "name": "webhookclient",
        "kind": "frontend",
        "paths": [
          "src/WebhookClient/**"
        ],
        "dependsOn": [
          "eshop-servicedefaults"
        ],
        "unitTests": "tests/Application.UnitTests"
      },
      {
        "name": "webhooks-api",
        "kind": "backend",
        "paths": [
          "src/Webhooks.API/**"
        ],
        "dependsOn": [
          "eventbusrabbitmq",
          "integrationeventlogef",
          "eshop-servicedefaults"
        ],
        "unitTests": "tests/Application.UnitTests"
      },
      {
        "name": "eshop-apphost",
        "kind": "host",
        "paths": [
          "src/eShop.AppHost/**"
        ],
        "unitTests": "tests/eShop.AppHost.UnitTests"
      },
      {
        "name": "eshop-servicedefaults",
        "kind": "library",
        "paths": [
          "src/eShop.ServiceDefaults/**"
        ]
      },
      {
        "name": "shared",
        "kind": "library",
        "paths": [
          "src/Shared/**"
        ],
        "shared": true,
        "note": "src/Shared: sources linked into several services (Compile Include)"
      }
    ],
    "frontendPaths": [
      "src/WebApp/**",
      "src/WebAppComponents/**",
      "src/WebhookClient/**",
      "src/Identity.API/Views/**",
      "src/Identity.API/wwwroot/**"
    ],
    "testRoots": [
      "tests/Application.UnitTests",
      "tests/Basket.FunctionalTests",
      "tests/Basket.UnitTests",
      "tests/Catalog.FunctionalTests",
      "tests/Ordering.FunctionalTests",
      "tests/Ordering.UnitTests",
      "tests/Webhooks.FunctionalTests",
      "tests/eShop.AppHost.UnitTests",
      "e2e"
    ]
  },
  "lsp": {
    "servers": [
      {
        "id": "csharp",
        "extensions": [
          ".cs"
        ],
        "languageIds": [
          "csharp"
        ],
        "command": "node",
        "args": [
          "pack:dotnet/lsp/roslyn-proxy.mjs",
          "dotnet",
          "tool",
          "run",
          "roslyn-language-server",
          "--stdio",
          "--telemetryLevel",
          "off",
          "--logLevel",
          "Warning"
        ],
        "env": {
          "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
          "DOTNET_NOLOGO": "1"
        },
        "leased": true,
        "reportsState": true,
        "loadTimeoutSec": 900,
        "prepare": {
          "command": "node",
          "args": [
            "pack:dotnet/lsp/prepare.mjs"
          ],
          "label": "restoring tools and NuGet packages",
          "timeoutSec": 900
        },
        "scope": {
          "module": "pack:dotnet/lsp/scope.mjs",
          "options": {
            "solution": "eShop.slnx",
            "restoreSolution": "eShop.Web.slnf"
          }
        }
      },
      {
        "id": "typescript",
        "extensions": [
          ".ts",
          ".tsx",
          ".mts",
          ".cts",
          ".js",
          ".jsx",
          ".mjs",
          ".cjs"
        ],
        "languageIds": [
          "typescript",
          "typescriptreact",
          "javascript",
          "javascriptreact"
        ],
        "command": "typescript-language-server",
        "args": [
          "--stdio"
        ]
      }
    ],
    "check": [
      [
        "csharp",
        "src/Catalog.API/Program.cs",
        26,
        5
      ],
      [
        "typescript",
        "e2e/CartTest.spec.ts",
        6,
        9
      ]
    ]
  },
  "implement": {
    "prepareCmd": "dotnet restore eShop.Web.slnf -v q && npm ci",
    "checks": [
      {
        "name": "build",
        "cmd": "dotnet build eShop.Web.slnf -nologo -v q -clp:ErrorsOnly"
      },
      {
        "name": "test stack matches the application (factory teststack drift)",
        "cmd": "node .factory/bin/factory.mjs teststack drift"
      }
    ],
    "unitTests": {
      "cmd": "dotnet test --project {project}"
    },
    "reviewGate": {
      "floor": {
        "paths": [
          ".github/workflows/**",
          ".github/CODEOWNERS",
          ".factory/config.json",
          "**/Migrations/**",
          "src/Identity.API/**",
          "src/PaymentProcessor/**"
        ]
      },
      "sharedPaths": {
        "Build": [
          "Directory.Build.props",
          "Directory.Build.targets",
          "Directory.Packages.props",
          "global.json",
          "nuget.config"
        ]
      },
      "contractPaths": {
        "Integration events": [
          "src/Basket.API/IntegrationEvents/Events/**",
          "src/Catalog.API/IntegrationEvents/Events/**",
          "src/OrderProcessor/Events/**",
          "src/Ordering.API/Application/IntegrationEvents/Events/**",
          "src/PaymentProcessor/IntegrationEvents/Events/**",
          "src/WebApp/Services/OrderStatus/IntegrationEvents/Events/**",
          "src/Webhooks.API/IntegrationEvents/**"
        ]
      }
    },
    "ui": {
      "teststackCmd": [
        "node",
        ".factory/bin/factory.mjs",
        "teststack"
      ]
    }
  },
  "precheck": {
    "lint": {
      ".cs": [
        "dotnet",
        "format",
        "eShop.Web.slnf",
        "--verify-no-changes",
        "--include",
        "{files}"
      ],
      ".md": [
        "node_modules/.bin/markdownlint",
        "{files}"
      ]
    },
    "fix": {
      ".cs": [
        "dotnet",
        "format",
        "eShop.Web.slnf",
        "--include",
        "{files}"
      ],
      ".md": [
        "node_modules/.bin/markdownlint",
        "--fix",
        "{files}"
      ]
    },
    "testRunners": [
      "dotnet",
      {
        "use": "playwright/playwright",
        "run": [
          "npx",
          "playwright",
          "test",
          "-c",
          "playwright.teststack.config.ts",
          "--grep",
          "{casePrefix}",
          "{files}"
        ],
        "roots": [
          "e2e/teststack"
        ],
        "match": [
          "e2e/teststack/**/*.spec.ts"
        ]
      }
    ]
  },
  "implExclude": [
    ".factory",
    "graphify-out",
    "tests/Application.UnitTests",
    "tests/Basket.FunctionalTests",
    "tests/Basket.UnitTests",
    "tests/Catalog.FunctionalTests",
    "tests/Ordering.FunctionalTests",
    "tests/Ordering.UnitTests",
    "tests/Webhooks.FunctionalTests",
    "tests/eShop.AppHost.UnitTests",
    "e2e",
    "tests/ClientApp.UnitTests"
  ],
  "stack": {
    "resolver": "pack:dotnet/stack/services.mjs",
    "rebuildAll": [
      "Directory.Build.props",
      "Directory.Build.targets",
      "Directory.Packages.props",
      "global.json",
      "nuget.config",
      ".factory/stack/docker-compose.yaml"
    ],
    "composeFile": ".factory/stack/docker-compose.yaml",
    "ports": {
      "webapp": {
        "base": 28080,
        "env": "WEBAPP_HOST_PORT"
      },
      "identity": {
        "base": 28081,
        "env": "IDENTITY_API_HOST_PORT"
